# Локальный стенд (docker compose)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme
POSTGRES_DB=n8n
TZ=Europe/Moscow

# Ключ шифрования креденшелов n8n.
# Без фиксированного значения при пересоздании контейнера все сохранённые
# доступы перестают читаться. Для локального стенда — любая строка.
N8N_ENCRYPTION_KEY=local-dev-key-change-me

# Куда деплоить. Для локального стенда — http://localhost:5678
# Ключ берётся в интерфейсе n8n: Settings → API
N8N_URL=http://localhost:5678
N8N_API_KEY=
